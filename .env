# CONFIGURACIÃ“N PHANTOM REINTEGRO
# ============================================
DELAY=10
ROUTE_KNOWN_HOSTS="C:\Users\Administrador\.ssh\known_hosts"
ROUTE_MACS="macs.txt"
FIRMWARE_PATH="Firmware_PHANTOM.bin"
DEVICE_IP="192.168.1.1"
DEVICE_USER="root"
DEVICE_PORT="22"
SSH_TIMEOUT="10"
SCP_TIMEOUT="15"
COMMAND1="uci show network.@device[1].macaddr"
COMMAND2="sysupgrade -n /tmp/Firmware_PHANTOM.bin"
MAC_PATTERN="'([0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5})'"
MAX_ATTEMPTS="100"

