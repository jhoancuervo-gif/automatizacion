backups_macs/
# Ignoramos archivos de datos que se llenan con el uso
macs.txt
macs
# Archivos basura o temporales detectados en tu carpeta[cite: 1]
.txt

# === Logs y Temporales ===
logs/
*.log
*.backup
*.tmp

# === Entornos de Python (Automation) ===
# No subir las librerías instaladas, solo el script[cite: 1]
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/
.venv/

# === Archivos de Sistema ===
.DS_Store
Thumbs.db
desktop.ini

