# ============================================
# PLANTILLA DE CONFIGURACION - COPIAR A .env
# ============================================
# Copie este archivo como ".env" y rellene los valores reales.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# ============================================
# CONFIGURACION PHANTOM REINTEGRO
# ============================================
DELAY=10
ROUTE_KNOWN_HOSTS="C:\Users\TU_USUARIO\.ssh\known_hosts"
ROUTE_MACS="macs.txt"
FIRMWARE_PATH="Firmware_PHANTOM.bin"
DEVICE_IP="192.168.1.1"
DEVICE_USER="root"
DEVICE_PORT="22"
SSH_TIMEOUT="10"
SCP_TIMEOUT="15"
COMMAND1="uci show network.@device[1].macaddr"
COMMAND2="sysupgrade -n /tmp/Firmware_PHANTOM.bin"
MAC_PATTERN="'([0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5})'"
MAX_ATTEMPTS="100"

# ============================================
# CREDENCIALES PORTAL ISP
# ============================================
ISP_USERNAME=usuario@dominio.com
ISP_PASSWORD=TU_CONTRASENA_AQUI
PORTAL_URL=https://isp.somosinternet.com
MAC_FILE_PATH=macs.txt

# ============================================
# CONFIGURACION RANGOS IP
# ============================================
IP_BASE=192.168.10.
IP_START=200
IP_END=250

# ============================================
# NOTIFICACIONES DISCORD
# ============================================
# Canal: ingreso-al-script
DISCORD_WEBHOOK_INGRESO=
# Canal: produccion-flasheo
DISCORD_WEBHOOK_PRODUCCION=
# Canal: alertas-scripts (errores criticos)
DISCORD_WEBHOOK_ERRORES=
